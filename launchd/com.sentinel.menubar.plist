<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: opens the menu-bar app at login. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.sentinel.menubar</string>
	<key>ProgramArguments</key>
	<array>
		<string>@MENUBAR_EXE@</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
