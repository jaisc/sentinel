{
  "manifest_version": 3,
  "name": "Sentinel Link Guard",
  "version": "1.0.0",
  "description": "Checks links before they open (local heuristics + your Mac's Sentinel engine). No accounts, no telemetry.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["webNavigation", "tabs", "storage", "contextMenus", "nativeMessaging"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Sentinel Link Guard",
              "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
